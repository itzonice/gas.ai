# StudyPulse environment variables.
# Each runtime reads its own file; copy the matching section:
#   apps/web/.env.local          <- "Web" section
#   apps/mobile/.env             <- "Mobile" section
#   supabase/functions/.env      <- "Edge functions" section (local `supabase functions serve`)
# In deployed environments set web vars in Vercel, mobile vars in EAS, and edge
# secrets with `supabase secrets set`. Every variable is validated with zod at
# startup (packages/core/src/env).
#
# Local Supabase URL and keys come from `pnpm db:start` / `supabase status`.

# ---------------------------------------------------------------- Web (Next.js)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# Server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ Mobile (Expo)
# Everything here ships inside the app bundle. Never put secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------- Edge functions (Deno)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by Supabase; only set them when running functions elsewhere.
APP_ENV=development
ANTHROPIC_API_KEY=
SENTRY_DSN=

# ------------------------------------------------------------- Sentry build-time
# Needed only where source maps are uploaded (Vercel, EAS, CI).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
