{
  "name": "@studypulse/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env/index.ts",
    "./observability": "./src/observability/index.ts",
    "./parser": "./src/parser/index.ts",
    "./time": "./src/time/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "parser:schema": "node scripts/gen-parser-schema.ts && prettier --write src/parser/prompts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@studypulse/db": "workspace:*",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
