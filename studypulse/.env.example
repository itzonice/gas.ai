# StudyPulse environment variables.
# Each runtime reads its own file; copy the matching section:
#   apps/web/.env.local          <- "Web" section
#   apps/mobile/.env             <- "Mobile" section
#   supabase/functions/.env      <- "Edge functions" section (local `supabase functions serve`)
# In deployed environments set web vars in Vercel, mobile vars in EAS, and edge
# secrets with `supabase secrets set`. Every variable is validated with zod at
# startup (packages/core/src/env).
#
# Local Supabase URL and keys come from `pnpm db:start` / `supabase status`.

# ---------------------------------------------------------------- Web (Next.js)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# Web push: the VAPID public key (same as VAPID_PUBLIC_KEY below).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ Mobile (Expo)
# Everything here ships inside the app bundle. Never put secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
# RevenueCat public SDK keys (Project settings -> API keys). Public by design.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Only if Expo push security (access tokens) is enabled for the project.
EXPO_ACCESS_TOKEN=
# Shared secret for cron-invoked functions; also store it in Vault as 'cron_secret'.
CRON_SECRET=

# ------------------------------------------------------- Edge functions (Deno)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by Supabase; only set them when running functions elsewhere.
APP_ENV=development
ANTHROPIC_API_KEY=
# Optional override; defaults to the parser's default model (packages/core/src/parser/ai.ts).
PARSER_MODEL=
SENTRY_DSN=
# Web push (VAPID) for web users without the mobile app. Generate a pair once per
# environment with `pnpm --filter @studypulse/core vapid:keys`; the private key is secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@studypulse.app
# Email digest (Resend) for users without push. Verify the sending domain in Resend.
RESEND_API_KEY=
EMAIL_FROM="StudyPulse <reminders@mail.studypulse.app>"
# Signs unsubscribe links; at least 32 random characters (openssl rand -base64 32).
EMAIL_UNSUBSCRIBE_SECRET=
APP_URL=http://localhost:3000
# Stripe (web billing). Use test-mode keys and prices outside production.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Signing secret of the webhook endpoint (Stripe dashboard, or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=
# Student discount: a Stripe coupon id (create it without a public promotion code).
STRIPE_STUDENT_COUPON_ID=
# Extra academic email domains, comma-separated (e.g. ethz.ch,epfl.ch).
STUDENT_EMAIL_DOMAINS=
# RevenueCat webhook: the Authorization header value set in the RevenueCat dashboard
# (at least 24 random characters).
REVENUECAT_WEBHOOK_AUTH=
# Optional: pin the Stripe API version (defaults to the account's version).
STRIPE_API_VERSION=

# ------------------------------------------------------------- Sentry build-time
# Needed only where source maps are uploaded (Vercel, EAS, CI).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
